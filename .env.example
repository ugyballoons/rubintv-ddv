# Path segment of the DDV client websocket on the same host as the page.
# RubinTV mounts it at {prefix}/ws/ddv, so the browser connects to {prefix}/ws/ddv/client.
VITE_DDV_WS_PATH=rubintv/ws/ddv
# Optional explicit port for local development against scripts/mock_server.py.
# VITE_DDV_WS_PORT=9925
# VITE_DDV_WS_PATH=ws
